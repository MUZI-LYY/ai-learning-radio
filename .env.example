# ============================================================
# AI 学习电台 - 环境变量示例
# 复制为 .env 后填写；本文件只含变量名与安全占位值，不含真实密钥。
# 真实 Key 只允许进入本地 .env 或部署平台 Secret，绝不提交 Git。
# ============================================================

# ---- 运行环境 ----
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
FRONTEND_ORIGIN=http://127.0.0.1:3001

# ---- 数据与存储 ----
# 默认使用项目根目录下的 data/app.db 与 data/private。
# 如需覆盖，请取消注释并使用绝对路径，避免工作目录改变相对路径语义。
# DATABASE_URL=sqlite:////absolute/path/to/app.db
# PRIVATE_STORAGE_ROOT=/absolute/path/to/private-storage

# ---- LLM（火山方舟）----
# mock | volcark
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL_PRIMARY=doubao-seed-2-1-pro-260628
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=8192

# ---- TTS（豆包语音，语音技术新版 API Key 接入）----
# mock | volc
TTS_PROVIDER=mock
# 语音技术控制台创建的 API Key（与方舟 LLM Key 不同）
TTS_API_KEY=
TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
TTS_RESOURCE_ID=volc.service_type.10029
TTS_DEFAULT_VOICE_KEY=elegant_youth
TTS_TIMEOUT_SECONDS=300
# TTS 成本估值（人民币元 / 千字），请按实际供应商价格校准
TTS_COST_PER_1K_CHARS_CNY=0.2

# ---- 输入与额度限制 ----
MAX_UPLOAD_MB=15
MAX_EXTRACTED_CHARS=30000
DAILY_PRIVATE_PROGRAM_LIMIT=2

# ---- 成本熔断 ----
# 未配置月度预算前，必须保持为 false，禁止真实 Provider 调用
PROVIDER_CALLS_ENABLED=false
# 0 表示未配置；未配置时真实 Provider 调用一律熔断
PROJECT_MONTHLY_BUDGET_CNY=0

# ---- Worker ----
WORKER_POLL_SECONDS=3

# ---- 前端配置位置 ----
# Next.js 从 frontend/ 目录启动，不会读取本文件。
# 请复制 frontend/.env.example 为 frontend/.env.local，并在那里设置 NEXT_PUBLIC_API_BASE。
